{
    "version": 2,
    "builds": [{
            "src": "admin/package.json",
            "use": "@vercel/next"
        },
        {
            "src": "web/package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [{
            "src": "/admin/(.*)",
            "dest": "admin/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/web/$1"
        }
    ]
}